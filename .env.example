# AIShield 环境变量配置模板
# 复制为 .env 并填入实际值

# ── 服务配置 ──
AISHIELD_PORT=8450
PYTHONUNBUFFERED=1

# ── Creem 支付（必须配置）──
CREEM_API_KEY=creem_your_api_key_here
CREEM_WEBHOOK_SECRET=whsec_your_webhook_secret_here
CREEM_TEST_MODE=true  # 生产环境改为 false

# ── 虎皮椒支付（CNY · 微信/支付宝，国内市场；商户号需自行申请后填入）──
# 申请地址：https://www.xunhupay.com/  需真实 AppID/Secret 后才能开通人民币支付
HUPIJIAO_APPID=
HUPIJIAO_SECRET=

# ── 可选：LLM 增强 ──
AISHIELD_LLM_URL=
AISHIELD_LLM_KEY=
